<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP to any host — this app's sole purpose is connecting
  to a local paperclip server on the LAN where TLS is not configured.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
